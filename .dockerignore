**/*.gguf
**/*.onnx
**/*.ckpt
**/*.pth
**/*.pt
**/*.bin

# Local credentials and configuration are not Docker build inputs.
.env
.env.*
**/.env
**/.env.*
**/*secret*
**/*credential*
**/kaggle.json
**/all-kaggle.json
**/*.pem
**/*.key
