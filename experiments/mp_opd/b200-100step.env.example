# Copy outside Git, chmod 600, and edit. Never put secrets in this file.
MP_OPD_STUDENT_PATH=/company/models/simct/student-warm-sft
MP_OPD_TEACHER_PATH=/company/models/simct/teacher
MP_OPD_DATASET_PATH=/company/datasets/simct/train
MP_OPD_OUTPUT_ROOT=/workspace/outputs/mp-opd-b200-100step
MP_OPD_EVIDENCE_DIR=/workspace/outputs/mp-opd-b200-100step/evidence
MP_OPD_GPU_COUNT=1
MP_OPD_MODE=atomic
MP_OPD_MAX_SPAN_LENGTH=4
MP_OPD_FIXED_SPAN_LENGTH=2
MP_OPD_RANDOM_SEED=43
MP_OPD_PARTITION_TEMPERATURE=1.0
MP_OPD_ENERGY_CHECKPOINT=
WANDB_PROJECT=vdt-simct-tunix-reproduction
WANDB_ENTITY=your-wandb-entity
WANDB_RUN_NAME=mp-opd-b200-atomic-100step
WANDB_DIR=/workspace/outputs/mp-opd-b200-100step/wandb
TENSORBOARD_LOG_DIR=/workspace/outputs/mp-opd-b200-100step/tensorboard
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_IMPLICIT_TOKEN=1
