# Copy this file outside the Git worktree, chmod 600, and edit the copy.
# Do not add tokens, passwords, internal package URLs, or proxy credentials.

# Repository/runtime layout.
B200_ENV_ROOT=/workspace/venvs
UV_CACHE_DIR=/workspace/cache/uv
HF_HOME=/workspace/cache/huggingface
SIMCT_OUTPUT_ROOT=/workspace/outputs/simct-b200
SIMCT_RUN_EVIDENCE=/workspace/outputs/simct-b200/evidence

# Existing paper scripts use these three roots.
MODEL_PATH=/company/models/simct
DATA_PATH=/company/datasets/simct
OUTPUT_PATH=/workspace/outputs/simct-b200

# Exact local paths for company layouts that do not match paper-script names.
SIMCT_SFT_BASE_MODEL_PATH=/company/models/simct/gemma-2-2b-it
SIMCT_TEACHER_MODEL_PATH=/company/models/simct/Qwen2.5-7B-Instruct
SIMCT_SFT_CHECKPOINT_PATH=/workspace/outputs/simct-b200/sft-checkpoint/checkpoint-5
SIMCT_TRAIN_DATASET_PATH=/company/datasets/simct/mixed_math_code_10k

# LlamaFactory dataset registry directory/name for the bounded SFT gate.
SIMCT_SFT_DATASET_DIR=/company/datasets/simct/llamafactory
SIMCT_SFT_DATASET_NAME=gsm8k_sft_canary
SIMCT_CHAT_TEMPLATE=gemma

# Hardware and experiment tracking. Keep WANDB_API_KEY in a secret manager.
SIMCT_GPU_COUNT=8
WANDB_PROJECT=vdt-simct-tunix-reproduction
WANDB_RUN_NAME=simct-b200-sft-5step-company
WANDB_DIR=/workspace/outputs/simct-b200/wandb

# After model manifests are verified, these prevent accidental Hub fallback.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_IMPLICIT_TOKEN=1
